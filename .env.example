# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SUPABASE: Database, Auth, and Storage configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# APP_URL: Host URL for self-referential links
APP_URL="MY_APP_URL"

# CHATANYWHERE: API Key for AI Senior Engineering Mentor chat
CHATANYWHERE_API_KEY=""
# CHATANYWHERE_BASE_URL: Optional API endpoint (defaults to https://api.chatanywhere.tech/v1)
CHATANYWHERE_BASE_URL="https://api.chatanywhere.tech/v1"
# CHATANYWHERE_MODEL: Model to use with ChatAnywhere (defaults to gpt-3.5-turbo or gpt-4o-mini)
CHATANYWHERE_MODEL="gpt-3.5-turbo"
